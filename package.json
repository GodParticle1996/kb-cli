{
  "name": "kb",
  "version": "0.2.0",
  "description": "kb — Central Memory for AI coding tools. Captures session context from Claude / Kimchi / OpenCode / Codex / Cline into per-tool knowledge bases so any future session can restore it.",
  "type": "module",
  "bin": {
    "kb": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "cli",
    "knowledge-base",
    "llm",
    "context",
    "claude",
    "cline",
    "ai",
    "memory",
    "wiki"
  ],
  "author": "@vibekdutta",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@lancedb/lancedb": "^0.31.0",
    "chokidar": "^5.0.0",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "groq-sdk": "^1.3.0",
    "openai": "^6.45.0",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
